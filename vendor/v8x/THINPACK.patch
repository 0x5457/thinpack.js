+fn utf8_is_array_index(bytes: &[c_char]) -> bool {
+  if bytes.is_empty() || bytes.len() > 10 {
+    return false;
+  }
+  if bytes[0] as u8 == b'0' {
+    return bytes.len() == 1;
+  }
+  let mut value: u64 = 0;
+  for &byte in bytes {
+    let byte = byte as u8;
+    if !byte.is_ascii_digit() {
+      return false;
+    }
+    value = value * 10 + u64::from(byte - b'0');
+  }
+  value <= u64::from(u32::MAX)
+}
