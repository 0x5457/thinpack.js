+static int find_local_scope_var(JSFunctionDef *s, JSAtom var_name,
+                                int scope_level)
+{
+    int idx;
+    if (!s->vars_htab) {
+        for (idx = s->scopes[scope_level].first; idx >= 0;
+             idx = s->vars[idx].scope_next) {
+            if (s->vars[idx].var_name == var_name)
+                return idx;
+        }
+        return -1;
+    }
+
+    uint32_t mask = s->var_count + s->var_count / 5;
+    mask = UINT32_MAX >> clz32(mask);
+    for (int scope = scope_level; scope >= 0; scope = s->scopes[scope].parent) {
+        uint32_t hash = hash32(var_name);
+        uint32_t step = 1;
+        int found = -1;
+        for (;;) {
+            uint32_t index = s->vars_htab[hash & mask];
+            if (index == UINT32_MAX)
+                break;
+            JSVarDef *vd = &s->vars[index];
+            if (vd->var_name == var_name && vd->scope_level == scope)
+                found = index;
+            hash += step++;
+        }
+        if (found >= 0)
+            return found;
+    }
+    return -1;
+}
